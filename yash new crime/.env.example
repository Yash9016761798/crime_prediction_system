# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# PostgreSQL (copy to .env and fill in your own values - .env is gitignored)
# Either set DATABASE_URL, or the individual DB_* variables.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/crime_intel
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=crime_intel
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required (server refuses to boot in production without it).
# ---------------------------------------------------------------------------
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=7d

# ---------------------------------------------------------------------------
# Security / CORS
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Frontend (Vite) - these are read at build time, prefixed with VITE_
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api

# Map Configuration
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Environment
VITE_ENV=development
